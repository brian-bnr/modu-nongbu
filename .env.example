# Supabase: use the "Transaction" pooled connection string (port 6543) for DATABASE_URL
# and the "Session"/direct connection string (port 5432) for DIRECT_URL.
# Project Settings > Database > Connection string in the Supabase dashboard.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# NextAuth
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Seed script uses these to create the initial admin account
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Social login (Google / Kakao / Naver)
# Redirect URI to register in each provider's console:
#   https://www.mdfarm.co.kr/api/auth/callback/google
#   https://www.mdfarm.co.kr/api/auth/callback/kakao
#   https://www.mdfarm.co.kr/api/auth/callback/naver
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# 드론 예약 자동승인 배치 (/api/cron/auto-approve-drone) 인증용 시크릿.
# AWS EventBridge Scheduler가 이 값을 Authorization: Bearer 헤더로 전송하도록 별도 설정해야 합니다(자동 주입 아님).
# 강한 랜덤 값으로 직접 생성해서 여기와 EventBridge 양쪽에 동일하게 설정하세요.
CRON_SECRET=""

# 파일 업로드(게시글 이미지, 드론 작업사진) 저장용 S3 버킷 (AWS 콘솔 > S3에서 생성)
S3_BUCKET_NAME=""
AWS_REGION="ap-northeast-2"
# 로컬 개발 시에만 필요 (Amplify 배포본은 IAM 역할로 자격증명을 받으므로 콘솔 환경변수에 넣지 않습니다)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# 드론 방제 신청 지도/필지 조회
# 네이버 클라우드 플랫폼(ncloud.com) 콘솔 > Application Services > Maps > Application 등록 후 발급 (Web Dynamic Map 체크 필수)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=""
# 브이월드(vworld.kr) 회원가입 > 오픈API > 인증키 신청 후 발급
VWORLD_API_KEY=""
# 드론 방제 신청 지도의 "위성지도" 보기 (구글 지도 위성 사진 + 지적도 겹쳐보기)
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급 (Maps JavaScript API 활성화 필요, 결제 계정 등록 필요)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# 투자자 소개 페이지(/investors) 비밀번호 보호 — 값을 비워두면 보호 없이 공개됩니다.
INVESTOR_PAGE_PASSWORD=""

# 나이스페이먼츠(NICEPAY) 결제 연동
# https://developers.nicepay.co.kr 로그인 > 상점 생성 > "개발정보" 탭에서 클라이언트키/시크릿키 확인
# 샌드박스(테스트) 상점은 가입 즉시 자동 생성되어 바로 테스트 가능하며, 실 서비스용 운영 상점은 별도 가맹점 심사 후 발급됩니다.
# 결제창 JS SDK에서 그대로 노출되는 값이라 NEXT_PUBLIC_ 접두사가 필요합니다.
NEXT_PUBLIC_NICEPAY_CLIENT_ID=""
# 서버에서 승인/취소 API 호출 시에만 사용되는 비밀키 — 절대 클라이언트에 노출되면 안 됩니다.
NICEPAY_SECRET_KEY=""
# 샌드박스 테스트 중에는 비워두거나 "sandbox"로 둡니다. 실 서비스 전환 시 "production"으로 변경.
NICEPAY_ENV="sandbox"
